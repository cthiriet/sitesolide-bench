---
import { docPath, sectionPath, type DocEntry, type Section } from '../lib/docs';

interface Props {
  section: Section;
  pages: DocEntry[];
  currentId?: string;
}

const { section, pages, currentId } = Astro.props;
---

<nav class="sidebar" aria-label={`${section.title} pages`}>
  <h2 class="sidebar__title"><a href={sectionPath(section)}>{section.title}</a></h2>
  <ul>
    {
      pages.map((page) => (
        <li>
          <a href={docPath(page)} aria-current={page.id === currentId ? 'page' : undefined}>{page.data.title}</a>
        </li>
      ))
    }
  </ul>
</nav>
