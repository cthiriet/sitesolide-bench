[Unit]
Description=Caddy in front of the Docker and micro-VM setups of the benchmark
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
Environment=HOME=/var/lib/bench-caddy
RuntimeDirectory=bench-caddy
ExecStart=/usr/bin/caddy run --config /etc/bench-caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/bench-caddy/Caddyfile --adapter caddyfile --address unix//run/bench-caddy/admin.sock --force
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
