IPAddressDeny=any
IPAddressAllow=localhost

# Listens on its own port, and on none of the machine's others.
SocketBindAllow=tcp:3051
SocketBindDeny=2019
SocketBindDeny=3000-3099
SocketBindDeny=3128-3129

