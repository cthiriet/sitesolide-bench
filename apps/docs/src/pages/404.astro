---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <main id="main" class="home">
    <section class="hero">
      <p class="hero__eyebrow">Error 404</p>
      <h1>That page does not exist</h1>
      <p class="hero__lede">It may have moved or been retired. Try one of the sections in the menu, or go back to the <a href="/">start page</a>.</p>
    </section>
  </main>
</Base>
